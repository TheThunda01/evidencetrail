<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="32.6.1">
  <diagram name="Pairing, agreement, and decisions" id="reviewer-comparison">
    <mxGraphModel dx="1000" dy="830" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1000" pageHeight="830">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Reviewer agreement starts with pairing coverage" style="html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;spacing=12;text;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#153c4a;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="940" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a" value="Reviewer A&#10;Preserve submitted values" style="html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;spacing=12;rounded=1;fillColor=#eef4f8;strokeColor=#88a8b7;fontColor=#183c4d;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="250" height="75" as="geometry" />
        </mxCell>
        <mxCell id="b" value="Reviewer B&#10;Preserve submitted values" style="html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;spacing=12;rounded=1;fillColor=#eef4f8;strokeColor=#88a8b7;fontColor=#183c4d;" vertex="1" parent="1">
          <mxGeometry x="710" y="110" width="250" height="75" as="geometry" />
        </mxCell>
        <mxCell id="keys" value="Pair by report_id + field&#10;One nonblank key per side" style="html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;spacing=12;rounded=1;fillColor=#e0f0ec;strokeColor=#528b79;fontColor=#173e32;" vertex="1" parent="1">
          <mxGeometry x="375" y="100" width="250" height="95" as="geometry" />
        </mxCell>
        <mxCell id="blocked" value="Missing or duplicate key&#10;Block ambiguous pairing&#10;Keep rows in coverage&#10;denominator" style="html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;spacing=12;rounded=1;fillColor=#fff2d9;strokeColor=#b58b42;fontColor=#614618;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="matched" value="Comparable pairs&#10;Demo: 19 / 20 rows on each&#10;side&#10;95% pairing coverage" style="html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;spacing=12;rounded=1;fillColor=#e0f0ec;strokeColor=#528b79;fontColor=#173e32;" vertex="1" parent="1">
          <mxGeometry x="375" y="270" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="unmatched" value="Valid key on only one side&#10;Keep unmatched rows visible&#10;Keep rows in coverage&#10;denominator" style="html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;spacing=12;rounded=1;fillColor=#fff2d9;strokeColor=#b58b42;fontColor=#614618;" vertex="1" parent="1">
          <mxGeometry x="710" y="270" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="answer" value="Answer + evidence status&#10;Demo: 17 exact matches, 2&#10;differences&#10;Nonblank rates have their own&#10;denominators" style="html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;spacing=12;rounded=1;fillColor=#eef4f8;strokeColor=#88a8b7;fontColor=#183c4d;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="285" height="125" as="geometry" />
        </mxCell>
        <mxCell id="locator" value="Source locations&#10;Demo: 2 matched pairs differ&#10;Reported separately from answer&#10;agreement" style="html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;spacing=12;rounded=1;fillColor=#eef4f8;strokeColor=#88a8b7;fontColor=#183c4d;" vertex="1" parent="1">
          <mxGeometry x="360" y="480" width="280" height="125" as="geometry" />
        </mxCell>
        <mxCell id="decision" value="Researcher decision&#10;Choose, enter, or defer; give&#10;reason&#10;Does not verify the source" style="html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;spacing=12;rounded=1;fillColor=#fff2d9;strokeColor=#b58b42;fontColor=#614618;" vertex="1" parent="1">
          <mxGeometry x="675" y="480" width="285" height="125" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="Synthetic demo counts illustrate the implementation, not reviewer reliability or scientific accuracy.&#10;Blank, one-sided blank, and nonblank pairs remain distinct. An empty rate denominator is undefined.&#10;Saving a decision again replaces that pair’s current decision; export before leaving the session." style="html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;spacing=12;text;strokeColor=none;fillColor=none;fontSize=14;fontColor=#425b65;" vertex="1" parent="1">
          <mxGeometry x="45" y="680" width="910" height="110" as="geometry" />
        </mxCell>
